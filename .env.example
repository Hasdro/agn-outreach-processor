# Zoho CRM OAuth — set these in the Vercel dashboard, never commit real values.
# Self-client or server-based app credentials from https://api-console.zoho.com
ZOHO_CLIENT_ID="1000.FOHXCM55IUPO4RKBZ2OQEJ766XG34Y"
ZOHO_CLIENT_SECRET="eb7178e41e20da4768fa5a061802d652bbf8510df4"
ZOHO_REFRESH_TOKEN="1000.03fb1032829e80de741d2839215921e5.fcee2b74d7fdb0d0d5405eb18efa44ca"

# Regional data centre. Match the account: .com (US/global), .eu, .in, .com.au, .jp, .sa
# Accounts host and API host must be from the SAME region or the token is rejected.
ZOHO_ACCOUNTS_HOST=https://accounts.zoho.com
ZOHO_API_HOST=https://www.zohoapis.com

# Local development only. Persists the access token to the OS temp directory so
# `vercel dev` does not mint a new one on every request and trip Zoho's refresh
# rate limit. Never set this on Vercel — it writes a live token to disk.
# ZOHO_TOKEN_CACHE=1
