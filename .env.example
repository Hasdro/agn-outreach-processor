# Zoho CRM OAuth — set these in the Vercel dashboard, never commit real values.
# Self-client or server-based app credentials from https://api-console.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Regional data centre. Match the account: .com (US/global), .eu, .in, .com.au, .jp, .sa
# Accounts host and API host must be from the SAME region or the token is rejected.
ZOHO_ACCOUNTS_HOST=https://accounts.zoho.com
ZOHO_API_HOST=https://www.zohoapis.com
