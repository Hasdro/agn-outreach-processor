# Zoho CRM OAuth — set these in the Vercel dashboard. Never commit real values.
# Create a Server-based Application at https://api-console.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Regional data centre. Match your account: .com (US/global), .eu, .in, .com.au, .jp, .sa
# The accounts host and API host must be from the SAME region or the token is rejected.
ZOHO_ACCOUNTS_HOST=https://accounts.zoho.com
ZOHO_API_HOST=https://www.zohoapis.com

# Local development only. Persists the access token to the OS temp directory so
# `vercel dev` does not mint a new one on every request and trip Zoho's refresh
# rate limit. Never set this on Vercel — it writes a live token to disk.
# ZOHO_TOKEN_CACHE=1

# Local testing only. Enables the record-deletion endpoint used by the test suite.
# ALLOW_CLEANUP=1

# Industry detection. The execute zapikey for the AGN CRM standalone that proxies
# Gemini (send_to_gemini_standalone). Leave blank to turn the feature off — the
# flow dropdown then stays manual and nothing else changes.
ZOHO_STANDALONE_ZAPIKEY=
